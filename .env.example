# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Environment mode: development | staging | production
APP_ENV=development

# REQUIRED in production (min 32 random chars; never use default/weak values).
# In development, if empty, a CSPRNG secret is generated once and persisted to backend/data/.session_secret.
PANCHAYAT_SESSION_SECRET=

# Optional pre-configured Panchayat Secretary passcode for admin_test / secretary@abcpanchayat.gov.in
# Leave empty in local preview to use the one-time First-Run Admin Setup flow.
PANCHAYAT_SECRETARY_PASSCODE=

# Optional maintenance reset secret required alongside Super Admin auth in non-production
PANCHAYAT_MAINTENANCE_KEY=

# Optional SHA-256/Fernet backup encryption passphrase for encrypted backup archives
PANCHAYAT_BACKUP_KEY=

# Database URL: defaults to local SQLite WAL (sqlite:///backend/data/panchayat.db).
# Production multi-user deployments should target PostgreSQL:
# DATABASE_URL=postgresql+psycopg://panchayat:CHANGE_ME@db:5432/panchayat
DATABASE_URL=

# Comma-separated explicit allowed origins (optional; defaults to same-origin Host/X-Forwarded-Host)
PANCHAYAT_ALLOWED_ORIGINS=

# Logging level: INFO | WARNING | ERROR | DEBUG
PANCHAYAT_LOG_LEVEL=INFO
